{
  "name": "fwcc-app",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "tsx --env-file-if-exists=.env server/sync.ts",
    "server": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && npm --prefix mobile run typecheck",
    "start": "npm --prefix mobile start",
    "web": "npm --prefix mobile run web",
    "check": "npm test && npm run typecheck",
    "test:browser": "playwright test",
    "format": "prettier --write \"server/**/*.ts\" \"mobile/App.tsx\" \"mobile/src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.{json,ts,md}\""
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "luxon": "^3.7.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  }
}
